{
  "name": "mochi-calendar",
  "version": "3.0.1",
  "description": "毛玻璃半透明桌面日程看板（进阶日/周/月视图与可靠提醒）",
  "main": "main.js",
  "author": "周周",
  "private": true,
  "build": {
    "appId": "com.zhouzhou.mochiboard",
    "productName": "夕拾",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "sign": false
    },
    "portable": {
      "artifactName": "${productName}.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  }
}
